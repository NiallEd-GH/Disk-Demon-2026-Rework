 67:12 => 1c;
 68:13 => 1d;
 69:14 => 34;
 70:15 => 34;
 71:16 => 1c;
 72:17 => 1d;
 73:18 => 1c;
 74:19 => 1d;
 75:1a => 1c;
 76:1b => 1d;
 77:1c => a;
 78:1d => 4a;
 79:1e => 2c;
 80:1f => 2d;
 81:}
