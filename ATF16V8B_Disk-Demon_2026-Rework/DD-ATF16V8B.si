/* ORDER: A4, A3, A2, A1, A0, Q8, Q7, Q6, Q5, Q4, Q3, Q2, Q1; */
ORDER: A4, A3, A2, A1, A0, 8Q, 7Q, 6Q, 5Q, 4Q, 3Q, 2Q, 1Q;

/* A4 is Input MSB, A0 is lsb */
/* 8Q is Output MSB, 1Q is lsb */

